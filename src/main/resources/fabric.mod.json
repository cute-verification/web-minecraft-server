{
	"schemaVersion": 1,
	"id": "cute-verification-server",
	"version": "${version}",
	"name": "cute-verification-server",
	"description": "The minecraft server side version of cute-verification, can communicate with cute-verification server",
	"authors": [
		"gdrfgdrf"
	],
	"contact": {
		"homepage": "https://github.com/cute-verification/",
		"sources": "https://github.com/cute-verification"
	},
	"license": "Apache License 2.0",
	"icon": "assets/cute-verification-server/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": [
			{
				"value": "io.github.gdrfgdrf.cuteverification.web.minecraft.server.impl.fabric.ServerMain",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cute-verification-server.mixins.json"
	],
	"depends": {
		"java": ">=8",
		"fabric": "*",
		"fabric-language-kotlin": "*"
	},
    "accessWidener": "cute-verification-server.accesswidener"
}